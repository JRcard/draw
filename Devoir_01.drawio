        <mxCell id="AGqOmCTpdcGBPZAjZRS0-157" value="SELECT date, heure, duree, animaux.nom FROM rendezVous INNER JOIN proprietaires ON proprietaires.fk_rendezVous = rendezvous.id INNER JOIN animaux ON animaux.fk_proprietaire = proprietaires.id WHERE fk_veterinaire = 102;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=1;sketch=1;curveFitting=1;jiggle=2;labelBackgroundColor=none;" vertex="1" parent="1">
